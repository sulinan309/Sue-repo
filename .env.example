# WatchBot V1.0 Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================
# Vision Model (Volcengine Doubao 2.0)
# ============================================================
VISION_API_KEY=your_volcengine_api_key
VISION_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL_ID=doubao-vision-pro-32k

# ============================================================
# ASR - Speech Recognition (Volcengine)
# ============================================================
ASR_API_KEY=your_asr_api_key
ASR_ENDPOINT=https://openspeech.bytedance.com/api/v1/asr
ASR_APP_ID=your_app_id

# ============================================================
# TTS - Speech Synthesis (Volcengine)
# ============================================================
TTS_API_KEY=your_tts_api_key
TTS_ENDPOINT=https://openspeech.bytedance.com/api/v1/tts
TTS_VOICE_TYPE=zh_female_sweet

# ============================================================
# SIP / Call Center
# ============================================================
SIP_SERVER=sip.example.com
SIP_USERNAME=your_sip_user
SIP_PASSWORD=your_sip_password

# ============================================================
# Database
# ============================================================
DATABASE_URL=sqlite+aiosqlite:///./watchbot.db

# ============================================================
# Application
# ============================================================
DEBUG=false
DATA_DIR=./data
